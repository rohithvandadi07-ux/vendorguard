# Backend Environment Variables
DATABASE_URL=postgresql://postgres:password@db:5432/vendorguard
SECRET_KEY=yoursupersecretkeythatshouldbeverylong
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party APIs (Optional - mock data used if 'mock' or empty)
VIRUSTOTAL_API_KEY=mock
ABUSEIPDB_API_KEY=mock
SHODAN_API_KEY=mock

# Postgres Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=vendorguard
